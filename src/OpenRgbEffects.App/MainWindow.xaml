<Window x:Class="OpenRgbEffects.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OpenRgbEffects.App.Controls"
        Title="OpenRGB Effects"
        Width="980" Height="720"
        MinWidth="860" MinHeight="620"
        Background="{StaticResource BgBrush}"
        Icon="pack://application:,,,/Assets/app.ico"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="20">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Border Width="40" Height="40" CornerRadius="10" Margin="0,0,12,0">
                    <Border.Background>
                        <ImageBrush ImageSource="pack://application:,,,/Assets/app.png" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="OpenRGB Effects" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Software-effecten via de OpenRGB SDK-server" Style="{StaticResource MutedText}" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="10" Height="10" Margin="0,0,8,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#FF5C7A" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ConnectionStatus}" Value="Connecting">
                                    <Setter Property="Fill" Value="#F5C16C" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ConnectionStatus}" Value="Connected">
                                    <Setter Property="Fill" Value="#2EE6A6" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="360" Style="{StaticResource MutedText}" />
            </StackPanel>
        </Grid>

        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,16" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Host" VerticalAlignment="Center" Style="{StaticResource MutedText}" Margin="0,0,8,0" />
                <TextBox Grid.Column="1" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Column="3" Text="Poort" VerticalAlignment="Center" Style="{StaticResource MutedText}" Margin="0,0,8,0" />
                <TextBox Grid.Column="4" Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="6" Content="{Binding ConnectLabel}" Command="{Binding ConnectCommand}"
                        Style="{StaticResource PrimaryButton}" MinWidth="150" />
                <Button Grid.Column="8" Content="Vernieuwen" Command="{Binding RefreshCommand}" MinWidth="110" />
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Margin="0,16,0,0" Background="Transparent">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Content="Starten met Windows" IsChecked="{Binding StartWithWindows}" Margin="0,0,20,0" />
                    <CheckBox Content="Minimaliseren naar systeemvak" IsChecked="{Binding MinimizeToTray}" Margin="0,0,20,0" />
                    <CheckBox Content="Laatste effect hervatten bij start" IsChecked="{Binding ResumeEffectOnStart}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1.15*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="Apparaten en zones" FontSize="16" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Alles" Command="{Binding SelectAllDevicesCommand}" Style="{StaticResource LinkButton}" />
                            <Button Content="Geen" Command="{Binding SelectNoDevicesCommand}" Style="{StaticResource LinkButton}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Kies op welke apparaten het effect draait. Zones zijn informatief; updates gaan per apparaat."
                               Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Devices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1E232C" CornerRadius="10" Padding="12" Margin="0,0,0,10"
                                            BorderBrush="#2B3140" BorderThickness="1">
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Top"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      FontWeight="SemiBold">
                                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                            </CheckBox>
                                            <TextBlock DockPanel.Dock="Top" Text="{Binding Details}"
                                                       Style="{StaticResource MutedText}" Margin="24,4,0,8" />
                                            <ItemsControl ItemsSource="{Binding Zones}" Margin="24,0,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#171A21" CornerRadius="6" Padding="8,4" Margin="0,0,0,6">
                                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" FontSize="12" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Effect" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <RadioButton Content="Statische kleur" GroupName="Effect"
                                     IsChecked="{Binding Effect, Converter={StaticResource EnumEquals}, ConverterParameter=Static}" />
                        <RadioButton Content="Ademhaling" GroupName="Effect"
                                     IsChecked="{Binding Effect, Converter={StaticResource EnumEquals}, ConverterParameter=Breathing}" />
                        <RadioButton Content="Regenboog / kleurenwiel" GroupName="Effect"
                                     IsChecked="{Binding Effect, Converter={StaticResource EnumEquals}, ConverterParameter=Rainbow}" />
                        <RadioButton Content="Golf over LEDs" GroupName="Effect"
                                     IsChecked="{Binding Effect, Converter={StaticResource EnumEquals}, ConverterParameter=Wave}" />

                        <TextBlock Text="Kleur" FontSize="16" FontWeight="SemiBold" Margin="0,18,0,10" />
                        <controls:ColorPickerControl SelectedColor="{Binding SelectedColor, Mode=TwoWay}" />

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Snelheid" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Style="{StaticResource MutedText}">
                                <TextBlock.Text>
                                    <Binding Path="Speed" StringFormat="{}{0:0}" />
                                </TextBlock.Text>
                            </TextBlock>
                        </Grid>
                        <Slider Minimum="1" Maximum="100" Value="{Binding Speed}" TickFrequency="1" IsSnapToTickEnabled="True" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Helderheid" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Style="{StaticResource MutedText}">
                                <TextBlock.Text>
                                    <Binding Path="Brightness" StringFormat="{}{0:0}" />
                                </TextBlock.Text>
                            </TextBlock>
                        </Grid>
                        <Slider Minimum="1" Maximum="100" Value="{Binding Brightness}" TickFrequency="1" IsSnapToTickEnabled="True" />

                        <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                            <Button Content="Starten" Command="{Binding StartCommand}"
                                    Style="{StaticResource PrimaryButton}" MinWidth="120" Margin="0,0,10,0" />
                            <Button Content="Stoppen" Command="{Binding StopCommand}"
                                    Style="{StaticResource DangerButton}" MinWidth="120" />
                        </StackPanel>
                        <TextBlock Margin="0,10,0,0" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                   Text="Effecten draaien in de app en sturen ongeveer 30 keer per seconde LED-updates. Stoppen zet de gekozen apparaten terug op statisch wit." />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
