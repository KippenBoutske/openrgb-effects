<UserControl x:Class="OpenRgbEffects.App.Controls.PreviewStripControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border CornerRadius="8" BorderBrush="#2B3140" BorderThickness="1" ClipToBounds="True" Background="#0B0D12">
        <Image x:Name="Image" Stretch="Fill" Height="28" RenderOptions.BitmapScalingMode="NearestNeighbor" />
    </Border>
</UserControl>
